# ==============================================================================
# VARIÁVEIS DE AMBIENTE DA STACK DE OBSERVABILIDADE ON-PREMISE (ADR-013)
# Copie este arquivo para .env dentro de infra/observability/ se desejar
# sobrescrever as credenciais locais padrão:
#   cp infra/observability/.env.example infra/observability/.env
# ==============================================================================

# 1. Grafana
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin_scia_local

# 2. Opik LLMOps (MySQL)
OPIK_MYSQL_ROOT_PASSWORD=opikroot
OPIK_MYSQL_DATABASE=opik
OPIK_MYSQL_USER=opik
OPIK_MYSQL_PASSWORD=opikpassword

# 3. GlitchTip (Gestão de Exceções)
GLITCHTIP_DATABASE_URL=postgresql://postgres:postgres@host.docker.internal:5432/sci_latex_db?schema=glitchtip
GLITCHTIP_SECRET_KEY=scia-glitchtip-super-secret-key-change-in-production
GLITCHTIP_DOMAIN=http://localhost:8005
