// Prisma Schema Definition for sci-latex-vscode
generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
}

enum Role {
  AUTHOR
  REVIEWER
  COORDINATOR
  MANAGER
  ADMIN
}

enum NITStatus {
  NOT_REQUIRED
  WAITING_NIT
  APPROVED_NIT
  REJECTED_NIT
}

enum SubmissionStatus {
  IN_PROGRESS
  WAITING_NIT
  SUBMITTED_TARGET
  SUBMITTED_BACKUP
  ACCEPTED_REVISION_REQUESTED
  ACCEPTED_CAMERA_READY
  REJECTED_WAITING_DECISION
  REJECTED_REOPENED_V2
  COMPLETED_PUBLISHED
}

enum DeadlineStatus {
  ON_TIME
  WARNING_SOON
  OVERDUE
}

enum PeriodStatus {
  ACTIVE
  ARCHIVED
  COMPLETED
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  name         String
  passwordHash String
  role         Role      @default(AUTHOR)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  // Relations
  coordinatedProjects Project[] @relation("ProjectCoordinator")
  managedProjects     Project[] @relation("ProjectManager")

  projects        ProjectMember[]
  sessions        Session[]
  auditLogs       AuditLog[]
  userTasks       Task[]             @relation("UserTasks")
  reviewerRCs     ReleaseCandidate[] @relation("ReviewerRCs")
  academicPeriods AcademicPeriod[]   @relation("ManagerAcademicPeriods")
}

model AcademicPeriod {
  id                  String       @id @default(uuid())
  name                String // e.g., "Academic Cycle 2026/2027"
  startDate           DateTime
  endDate             DateTime
  targetArticlesCount Int          @default(0)
  status              PeriodStatus @default(ACTIVE)
  managerId           String?
  manager             User?        @relation("ManagerAcademicPeriods", fields: [managerId], references: [id])
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
  deletedAt           DateTime?
  projects            Project[]
}

model Project {
  id               String  @id @default(uuid())
  name             String
  description      String?
  academicPeriodId String?
  coordinatorId    String
  managerId        String

  submissionStatus SubmissionStatus @default(IN_PROGRESS)
  currentVersion   Int              @default(1)
  ownerGeneration  Int              @default(0)
  targetConferenceName String?
  targetConferenceDate DateTime?
  backupConferenceName String?
  backupConferenceDate DateTime?

  doi            String?
  publicationUrl String?
  datasetUrl     String?
  publishedAt    DateTime?

  reviewerFeedback String?

  coordinator       User                @relation("ProjectCoordinator", fields: [coordinatorId], references: [id])
  manager           User                @relation("ProjectManager", fields: [managerId], references: [id])
  academicPeriod    AcademicPeriod?     @relation(fields: [academicPeriodId], references: [id])
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  deletedAt         DateTime?
  members           ProjectMember[]
  tasks             Task[]
  releaseCandidates ReleaseCandidate[]
  releases          Release[]
  nitProcesses      NitProcess[]
  stages            ProjectStage[]
  files             ProjectFile[]
  operations        DocumentOperation[]
  snapshots         DocumentSnapshot[]
  comments          ReviewComment[]
}

model ProjectMember {
  id        String  @id @default(uuid())
  userId    String
  projectId String
  role      Role
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([userId, projectId])
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  action     String
  entityType String
  entityId   String
  details    Json?
  createdAt  DateTime @default(now())
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model Session {
  id           String   @id @default(uuid())
  userId       String
  refreshToken String   @unique
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum StageStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  LOCKED
}

model ProjectStage {
  id                    String      @id @default(uuid())
  projectId             String
  title                 String
  description           String?
  order                 Int
  plannedStartAt        DateTime?
  plannedEndAt          DateTime?
  plannedCompletionDate DateTime?
  startedAt             DateTime?
  completedAt           DateTime?
  status                StageStatus @default(NOT_STARTED)
  isGatekeeper          Boolean     @default(false)
  gatekeeperType        String? // "NIT" | "TARGET_CONFERENCE" | "BACKUP_CONFERENCE"
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks   Task[]

  @@unique([projectId, order])
}

model Task {
  id           String     @id @default(uuid())
  projectId    String
  assignedToId String?
  stageId      String?
  title        String
  status       TaskStatus @default(NOT_STARTED)
  startDate    DateTime?
  startedAt    DateTime?
  dueDate      DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  project  Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  stage    ProjectStage? @relation(fields: [stageId], references: [id], onDelete: SetNull)
  assignee User?         @relation("UserTasks", fields: [assignedToId], references: [id])
}

enum TaskStatus {
  NOT_STARTED
  IN_PROGRESS
  REVIEW_REQUESTED
  IN_REVIEW
  CHANGES_REQUESTED
  COMPLETED
}

model ReleaseCandidate {
  id         String   @id @default(uuid())
  projectId  String
  versionTag String
  snapshotId String?
  status     RCStatus @default(SUBMITTED)
  feedback   String?
  reviewerId String?
  pdfUrl     String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  project  Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  reviewer User?   @relation("ReviewerRCs", fields: [reviewerId], references: [id])
}

enum RCStatus {
  SUBMITTED
  UNDER_REVIEW
  CHANGES_REQUESTED
  APPROVED
}

model Release {
  id         String   @id @default(uuid())
  projectId  String
  versionTag String
  version    Int      @default(1)
  title      String
  conference String?
  pdfUrl     String?
  createdAt  DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model NitProcess {
  id             String    @id @default(uuid())
  articleId      String
  status         NITStatus @default(WAITING_NIT)
  sentAt         DateTime
  sentNotes      String?
  approvedAt     DateTime?
  responseNotes  String?
  protocolNumber String?
  createdAt      DateTime  @default(now())

  article Project @relation(fields: [articleId], references: [id], onDelete: Cascade)
}

model ProjectFile {
  id         String   @id @default(uuid())
  projectId  String
  path       String
  fileType   String // "text" | "binary"
  mimeType   String
  sizeBytes  BigInt
  content    String?  @db.Text
  storageKey String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, path])
}

model DocumentOperation {
  id        String   @id @default(uuid())
  projectId String
  userId    String
  userName  String
  type      String
  position  Int
  text      String?  @db.Text
  length    Int?
  timestamp BigInt
  createdAt DateTime @default(now())
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model DocumentSnapshot {
  id        String   @id @default(uuid())
  projectId String
  version   Int
  content   String   @db.Text
  savedBy   String
  reason    String
  createdAt DateTime @default(now())
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model ReviewComment {
  id           String   @id @default(uuid())
  projectId    String
  file         String   @default("main.tex")
  from         Int      @map("from")
  to           Int      @map("to")
  selectedText String   @db.Text
  userId       String
  userName     String
  userColor    String   @default("#3b82f6")
  content      String   @db.Text
  status       String   @default("open") // "open" | "resolved"
  replies      Json     @default("[]")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}
