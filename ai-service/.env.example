# Provedor de LLM Ativo ("gemini" | "openai" | "ollama" | "auto")
LLM_PROVIDER=gemini

# 1. Google Gemini (Recomendado para pesquisa científica)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# 2. OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# 3. Escape Hatch Local (Ollama - 100% offline e gratuito)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.5:4b

# Ferramentas de Busca Opcionais
TAVILY_API_KEY=

# Chave de Serviço M2M (Fastify <-> SciAI)
INTERNAL_SERVICE_KEY=scia-internal-secret-change-in-production
