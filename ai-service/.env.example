# ==============================================================================
# AMBIENTE & METADADOS DO SERVIÇO
# ==============================================================================
ENVIRONMENT=development
PROJECT_NAME="SciAI Service"
API_V1_STR=/internal/v1
LOG_LEVEL=INFO

# Servidor HTTP Uvicorn
HOST=0.0.0.0
PORT=8000

# ==============================================================================
# SEGURANÇA MACHINE-TO-MACHINE (M2M) - FASTIFY <-> SCIAI
# ==============================================================================
# Em produção, DEVE ser injetada via Kubernetes Secret ou Vault
INTERNAL_SERVICE_KEY=scia-internal-secret-change-in-production

# URL base do microsserviço Backend principal (Fastify)
BACKEND_API_URL=http://localhost:3333

# Origens permitidas para CORS (separadas por vírgula ou lista JSON)
BACKEND_CORS_ORIGINS=*

# ==============================================================================
# MODELOS DE LINGUAGEM (LLM PROVIDERS)
# Opções válidas obrigatórias: "gemini" | "openai" | "ollama" (sem fallbacks que mascarem erros)
# ==============================================================================
LLM_PROVIDER=gemini

# 1. Google Gemini (Recomendado para pesquisa científica)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# 2. OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# 3. Escape Hatch Local (Ollama - 100% offline e gratuito)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.5:4b
OLLAMA_NUM_CTX=16384

# ==============================================================================
# FERRAMENTAS DE BUSCA OPCIONAIS (WEB SEARCH)
# ==============================================================================
TAVILY_API_KEY=

# ==============================================================================
# BANCO DE DADOS EM MEMÓRIA / CACHE / CHECKPOINTER (REDIS)
# ==============================================================================
REDIS_URL=redis://localhost:6379

# ==============================================================================
# OBSERVABILIDADE DE LLM (OPIK / COMET ML)
# ==============================================================================
OPIK_URL_OVERRIDE=http://localhost:5174/api
OPIK_PROJECT_NAME=scia-academic-copilot
OPIK_WORKSPACE=default

# ==============================================================================
# AIOPS OBSERVABILITY MCP GATEWAYS & SRE TELEMETRY
# ==============================================================================
# Em Dev Local: http://localhost:9090 | Em Docker: http://host.docker.internal:9090
PROMETHEUS_URL=http://localhost:9090
# Em Dev Local: http://localhost:3100 | Em Docker: http://host.docker.internal:3100
LOKI_URL=http://localhost:3100
# Em Dev Local: http://localhost:8005 | Em Docker: http://host.docker.internal:8005
GLITCHTIP_URL=http://localhost:8005
# Em Dev Local: postgresql://postgres:postgres@localhost:5432/sci_latex_db?schema=public | Em Docker: postgresql://postgres:postgres@postgres:5432/sci_latex_db?schema=public
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sci_latex_db?schema=public
AIOPS_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sci_latex_db?schema=public
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=sci_latex_db
PGBOUNCER_HOST=localhost
PGBOUNCER_PORT=6543

